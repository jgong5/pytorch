_gemm_param = None
_gemm_param_lock = threading.Lock()


def _inductor_tensor_arg(tensor):
    return flyc.from_torch_tensor(tensor).mark_layout_dynamic()


def _build_param():
{% if IS_MXFP %}
    return make_mxfp_param_and_validate(
        MXFP_FORMAT,
        GEMM_M,
        GEMM_N,
        GEMM_K,
        OUT_DTYPE,
        {
            "TILE_M": TILE_M,
            "TILE_N": TILE_N,
            "TILE_K": TILE_K,
            "STAGES": STAGES,
            "M_WAVES": M_WAVES,
            "N_WAVES": N_WAVES,
            "GROUP_M": GROUP_M,
            "LDS_SCALE": LDS_SCALE,
        },
        a_is_transposed=A_IS_TRANSPOSED,
        b_is_transposed=B_IS_TRANSPOSED,
    )
{% else %}
    has_k_tail = infer_has_k_tail(GEMM_K, TILE_K, STAGES)
    if USE_HALF_TILE_INTERLEAVED:
        has_k_tail = has_k_tail or (((GEMM_K + TILE_K - 1) // TILE_K) % 2 != 0)
    return make_gemm_param_and_validate(
        GEMM_M,
        GEMM_N,
        GEMM_K,
        {
            "dtype_id": GEMM_DTYPE_ID,
            "tile_m": TILE_M,
            "tile_n": TILE_N,
            "tile_k": TILE_K,
            "stages": STAGES,
            "m_waves": M_WAVES,
            "n_waves": N_WAVES,
            "group_m": GROUP_M,
            "use_half_tile_interleaved": USE_HALF_TILE_INTERLEAVED,
            "a_is_transposed": A_IS_TRANSPOSED,
            "b_is_transposed": B_IS_TRANSPOSED,
            "has_bias": False,
            "has_k_tail": has_k_tail,
        },
    )
{% endif %}


def _cached_param():
    global _gemm_param
    param = _gemm_param
    if param is None:
        with _gemm_param_lock:
            param = _gemm_param
            if param is None:
                param = _build_param()
                if param is None:
                    raise RuntimeError(
                        f"unsupported FlyDSL GEMM shape/config: M={GEMM_M}, N={GEMM_N}, "
                        f"K={GEMM_K}, tile=({TILE_M}, {TILE_N}, {TILE_K}), stages={STAGES}"
                    )
                _gemm_param = param
    return param


def _dispatch(kernel_tensors, param, stream):
    configure_flydsl_cache_dir()
    compile_args = (
        *(_inductor_tensor_arg(tensor) for tensor in kernel_tensors),
        param,
        stream,
    )
    flydsl_compile_only = os.environ.get("FLYDSL_COMPILE_ONLY") == "1"
    compile_only = os.environ.get("COMPILE_ONLY", "").lower() in (
        "1", "true", "yes", "on"
    )
    if compile_only != flydsl_compile_only:
        raise RuntimeError(
            "COMPILE_ONLY and FLYDSL_COMPILE_ONLY must only be enabled together "
            "by the FlyDSL precompile path"
        )
    if flydsl_compile_only:
        flyc.compile(_flydsl_kernel, *compile_args)
    else:
        run_cached_flydsl(
            _flydsl_kernel,
            *compile_args,
            constexpr_param=param,
            compiler=flyc.compile,
            dispatch_args=(*kernel_tensors, param, stream),
        )


{% if IS_MXFP %}
{{def_kernel("mat1", "mat2", "scale_a", "scale_b")}}
    output = {{get_output()}}
    # Convert the API RHS [K_storage, N] into the kernel's [N, K_storage] view.
    # The original strides are preserved so each operand can select its LDS path.
    kernel_tensors = (
        output,
        mat1.view(torch.uint8),
        mat2.transpose(0, 1).view(torch.uint8),
        scale_a.view(torch.uint8),
        scale_b.view(torch.uint8),
    )
{% else %}
{{def_kernel("mat1", "mat2")}}
    output = {{get_output()}}
    kernel_tensors = (output, mat1, mat2)
{% endif %}
    _dispatch(kernel_tensors, _cached_param(), stream)
    return output


def {{kernel_name}}_precompile(
    precompile_shapes,
    precompile_strides,
    precompile_dtypes,
    device_index=0,
    device_capability=None,
    flydsl_gpu_arch=None,
):
    """Warm FlyDSL's disk cache using metadata-only fake tensors."""
    del device_index, device_capability

    env_updates = {"COMPILE_ONLY": "1", "FLYDSL_COMPILE_ONLY": "1"}
    if flydsl_gpu_arch is not None:
        env_updates["FLYDSL_GPU_ARCH"] = flydsl_gpu_arch

    with temporary_env(env_updates):
        from torch._subclasses.fake_tensor import FakeTensorMode

        with FakeTensorMode():

            def _fake_proxy(name):
                return torch.empty_strided(
                    tuple(precompile_shapes[name]),
                    tuple(precompile_strides[name]),
                    dtype=getattr(torch, precompile_dtypes[name]),
                    device="cpu",
                )

            operands = [_fake_proxy(name) for name in _OPERAND_NAMES]
            {{kernel_name}}_main(*operands, _fake_proxy("output"), stream=0)
